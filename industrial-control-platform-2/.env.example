# Application
VITE_APP_TITLE=Industrial Control Platform
VITE_APP_VERSION=1.0.0

# Backend services
VITE_API_BASE_URL=http://localhost:5000
VITE_WEBSOCKET_URL=http://localhost:5000
VITE_MQTT_URL=ws://localhost:8083/mqtt

# Platform profiles
VITE_HONGZOS_CONFIG={}
VITE_WINDOWS_CONFIG={}
VITE_LINUX_CONFIG={}

# Device endpoints
VITE_ROBOT_ARM_IP=192.168.1.100
VITE_CONVEYOR_IP=192.168.1.101
VITE_VISION_CAMERA_IP=192.168.1.102
VITE_TEMP_SENSOR_IP=192.168.1.103

# Database placeholders
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=industrial_control
VITE_DB_USER=app_user
VITE_DB_PASSWORD=change-me

# Security placeholders
VITE_JWT_SECRET=change-me
VITE_SESSION_TIMEOUT=3600
VITE_ENCRYPTION_KEY=change-me

# Monitoring thresholds
VITE_MONITOR_INTERVAL=5000
VITE_ALERT_THRESHOLD_CPU=80
VITE_ALERT_THRESHOLD_MEMORY=80
VITE_ALERT_THRESHOLD_TEMPERATURE=70
